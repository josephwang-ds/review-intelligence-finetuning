# Model weights: ignore everything under models/ EXCEPT the merged QLoRA adapter
# actually used at serving time (src/local_model.py, 06_evaluate_finetuned.py) —
# without it, a fresh clone can't run Model Routing at all. Skips the redundant
# training checkpoint dir (same ~80MB duplicated).
models/*
!models/qwen-asap-qlora
models/qwen-asap-qlora/*
!models/qwen-asap-qlora/final
.env.*
node_modules/
.next/
.venv/
venv/
.ipynb_checkpoints/
.claude/
