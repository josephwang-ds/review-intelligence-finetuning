.env
data/
runtime/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.egg-info/
.streamlit/secrets.toml

# Model weights: ignore everything under models/ EXCEPT the merged QLoRA adapter
# actually used at serving time (src/local_model.py, 06_evaluate_finetuned.py) —
# without it, a fresh clone can't run Model Routing at all. Skips the redundant
# training checkpoint dir (same ~80MB duplicated).
models/*
!models/qwen-asap-qlora
models/qwen-asap-qlora/*
!models/qwen-asap-qlora/final
# .env.* blocks real secret files (.env.local, .env.production, ...) but must
# not swallow .env.example — that's a template with no real values, and the
# README's Quickstart depends on it being in the repo ("cp .env.example .env").
# It was accidentally excluded since the very first commit; fixed here.
.env.*
!.env.example
node_modules/
.next/
.venv/
venv/
.ipynb_checkpoints/
.claude/
